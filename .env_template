# VLM API configuration
# MODEL_TO_USE can be: mistral, openai, gemini, or selfhosted
# For selfhosted: requires a vLLM endpoint (e.g., Qwen2.5-VL-72B-Instruct via vllm + ngrok)
#
# vLLM / OpenAI-compatible endpoints (local vLLM, LiteLLM, OpenRouter, ...):
#   set MODEL_TO_USE=openai and OPENAI_BASE_URL to the server's /v1 URL.
#   The key may be a placeholder for servers that don't check it. Example:
#   MODEL_TO_USE=openai  OPENAI_BASE_URL=http://localhost:8000/v1  MODEL_NAME=Qwen/Qwen2.5-VL-72B-Instruct

MISTRAL_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ENDPOINT=
OPENAI_DEPLOYMENT_NAME=gpt-4o
OPENAI_API_VERSION=2024-08-01-preview
MODEL_TO_USE=mistral
MODEL_NAME=pixtral-large-latest
SELF_HOSTED_ENDPOINT=
GOOGLE_API_KEY=
